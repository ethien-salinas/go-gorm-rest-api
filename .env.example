# Copia este archivo a .env y completa los valores reales
# cp .env.example .env

# Base de datos
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=mydb
DB_PORT=5432
DB_SSLMODE=disable

# Servidor
PORT=3000

# Migraciones (solo activar en desarrollo)
AUTO_MIGRATE=true

# Logging
# LOG_TO_FILE=true  → escribe logs a archivos diarios rotativos en LOG_DIR
# LOG_TO_FILE=false → solo stdout (default)
LOG_TO_FILE=false
LOG_DIR=logs

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRY_HOURS=24

# Rate limiting (token bucket por IP)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Política de contraseñas (PCI DSS v4.0 + NIST SP 800-63B)
PASSWORD_HISTORY_COUNT=12
PASSWORD_MAX_AGE_DAYS=90
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
